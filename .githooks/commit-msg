#!/bin/sh
# Reject a commit message carrying an AI-attribution trailer.
#
# This pattern is intentionally vendor-neutral: a public file naming
# specific AI vendors would announce, to every visitor, exactly what it
# guards against -- the same leak this project already fixes for its
# .gitignore. co-authored-by:, "generated with", the robot emoji, and a
# noreply@ address cover every realistic attribution trailer without
# naming anyone. A stricter, vendor-specific list is kept locally only
# (see .git/hooks), never in a file this repository publishes.
if grep -qiE 'co-authored-by:|generated with|🤖|noreply@' "$1"; then
  echo "commit-msg hook: refusing commit — message carries an attribution trailer." >&2
  echo "Offending line(s):" >&2
  grep -inE 'co-authored-by:|generated with|🤖|noreply@' "$1" >&2
  exit 1
fi
